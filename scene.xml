<mujoco model="panda scene">
  <include file="panda.xml"/>

  <statistic center="0.3 0 0.4" extent="1"/>

  <!-- One weld per cube; all inactive at start -->
  <equality>
    <weld name="weld_red1"   body1="hand" body2="red_cube_1"   relpose="0 0 -0.1 1 0 0 0" active="false"/>
    <weld name="weld_red2"   body1="hand" body2="red_cube_2"   relpose="0 0 -0.1 1 0 0 0" active="false"/>
    <weld name="weld_blue1"  body1="hand" body2="blue_cube_1"  relpose="0 0 -0.1 1 0 0 0" active="false"/>
    <weld name="weld_blue2"  body1="hand" body2="blue_cube_2"  relpose="0 0 -0.1 1 0 0 0" active="false"/>
    <weld name="weld_green1" body1="hand" body2="green_cube_1" relpose="0 0 -0.1 1 0 0 0" active="false"/>
    <weld name="weld_green2" body1="hand" body2="green_cube_2" relpose="0 0 -0.1 1 0 0 0" active="false"/>
  </equality>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="bowl_red"   rgba="0.8 0.1 0.1 1"/>
    <material name="bowl_blue"  rgba="0.1 0.1 0.8 1"/>
    <material name="bowl_green" rgba="0.1 0.7 0.1 1"/>
  </asset>

  <worldbody>
    <camera name="cam_top" pos="0.45 -0.10 1.30" euler="0 55 85" fovy="65"/>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- ── Cubes: 2 per color, spread on table ── -->
    <!-- Red cubes -->
    <body name="red_cube_1" pos="0.60  0.10 0.03">
      <freejoint/>
      <geom type="box" size="0.03 0.03 0.03" rgba="1 0 0 1" mass="0.1"/>
    </body>
    <body name="red_cube_2" pos="0.60 -0.10 0.03">
      <freejoint/>
      <geom type="box" size="0.03 0.03 0.03" rgba="1 0 0 1" mass="0.1"/>
    </body>

    <!-- Blue cubes -->
    <body name="blue_cube_1" pos="0.45  0.20 0.03">
      <freejoint/>
      <geom type="box" size="0.03 0.03 0.03" rgba="0 0 1 1" mass="0.1"/>
    </body>
    <body name="blue_cube_2" pos="0.45 -0.20 0.03">
      <freejoint/>
      <geom type="box" size="0.03 0.03 0.03" rgba="0 0 1 1" mass="0.1"/>
    </body>

    <!-- Green cubes -->
    <body name="green_cube_1" pos="0.30  0.15 0.03">
      <freejoint/>
      <geom type="box" size="0.03 0.03 0.03" rgba="0 1 0 1" mass="0.1"/>
    </body>
    <body name="green_cube_2" pos="0.30 -0.15 0.03">
      <freejoint/>
      <geom type="box" size="0.03 0.03 0.03" rgba="0 1 0 1" mass="0.1"/>
    </body>

    <!-- ── Bowls: fixed, visual targets only ── -->
    <!-- Bowl = cylinder shell: outer ring geom, no top/bottom -->
    <!-- Red bowl at right -->
    <body name="red_bowl" pos="0.65 -0.35 0.0">
      <geom type="cylinder" size="0.06 0.005" pos="0 0 0.005"  rgba="0.8 0.1 0.1 1" mass="0"/>
      <geom type="cylinder" size="0.06 0.005" pos="0 0 0.04"   rgba="0.8 0.1 0.1 0.4" mass="0"/>
      <geom type="cylinder" size="0.055 0.02" pos="0 0 0.022"  rgba="0.8 0.1 0.1 0.3" mass="0"/>
    </body>

    <!-- Blue bowl at center -->
    <body name="blue_bowl" pos="0.45 -0.40 0.0">
      <geom type="cylinder" size="0.06 0.005" pos="0 0 0.005"  rgba="0.1 0.1 0.8 1" mass="0"/>
      <geom type="cylinder" size="0.06 0.005" pos="0 0 0.04"   rgba="0.1 0.1 0.8 0.4" mass="0"/>
      <geom type="cylinder" size="0.055 0.02" pos="0 0 0.022"  rgba="0.1 0.1 0.8 0.3" mass="0"/>
    </body>

    <!-- Green bowl at left -->
    <body name="green_bowl" pos="0.25 -0.35 0.0">
      <geom type="cylinder" size="0.06 0.005" pos="0 0 0.005"  rgba="0.1 0.7 0.1 1" mass="0"/>
      <geom type="cylinder" size="0.06 0.005" pos="0 0 0.04"   rgba="0.1 0.7 0.1 0.4" mass="0"/>
      <geom type="cylinder" size="0.055 0.02" pos="0 0 0.022"  rgba="0.1 0.7 0.1 0.3" mass="0"/>
    </body>

  </worldbody>

</mujoco>